{
  "name": "tben-l-sim",
  "version": "0.2.0",
  "description": "Simulador de remoto IO-Link TBEN-L 8 portas com PROFINET real (p-net) e célula de paletização 3D",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "start:demo": "node src/server.js --sem-profinet",
    "gsdml": "node tools/gen-gsdml.js",
    "build:driver": "bash pn-driver/build.sh",
    "test:sim": "node tools/test-sim.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "three": "0.128.0",
    "ws": "8.18.0"
  },
